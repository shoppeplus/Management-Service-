rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────

    /// Returns true when the request comes from an authenticated user.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Returns true when the authenticated user carries the 'admin' custom claim.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // ── Customers ────────────────────────────────────
    match /customers/{customerId} {
      // Admins can read any customer; employees can only read customers assigned to them.
      allow read:   if isAuthenticated() && (isAdmin() || resource.data.assignedTo == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || resource.data.assignedTo == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Messages ─────────────────────────────────────
    match /messages/{messageId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      // Only admins or the original sender may update a message (e.g. mark-as-read).
      allow update: if isAuthenticated() && (isAdmin() || resource.data.senderId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Orders ───────────────────────────────────────
    match /orders/{orderId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Products ─────────────────────────────────────
    match /products/{productId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Conversations ────────────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();
    }
  }
}
