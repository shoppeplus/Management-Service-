VITE_APP_MODE=demo
# Live mode uses the same-origin Vite proxy in development. Set this URL to
# the public HTTPS API base in production when a reverse proxy is configured.
# VITE_API_BASE_URL=https://your-domain.example/api/v1

# Inventory is an independent, authenticated backend; no browser Demo fallback.
# Leave empty to use the same-origin Vite/reverse proxy. Never put keys in VITE_*.
VITE_INVENTORY_API_BASE_URL=
# Set VITE_APP_MODE=demo only for an explicitly local, disposable demonstration.
# Local server settings. `npm run server:inventory` loads values from an untracked .env file.
# INVENTORY_DB_PATH=var/inventory.sqlite
# INVENTORY_HOST=127.0.0.1
# INVENTORY_PORT=3001
# INVENTORY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# NODE_ENV=production
# INVENTORY_BOOTSTRAP_TOKEN=<server-only secret, at least 32 characters>
# TELEGRAM_BOT_TOKEN=<new server-only bot token; never use a token exposed in a screenshot>

# Server-only Gemini configuration. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Required to save credentials entered in Settings. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# TikTok Login Kit (personal account). Keep these server-only; register the
# HTTPS callback URL in the TikTok Developer Portal.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/v1/integrations/settings/tiktok/callback

# TikTok Shop uses a separate Partner app and callback URL.
TIKTOK_SHOP_REDIRECT_URI=https://your-domain.example/api/v1/integrations/settings/tiktokshop/callback
